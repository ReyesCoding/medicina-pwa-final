{
  "//": "El service worker corre en otro contexto (WebWorker, sin DOM): se tipa aparte.",
  "include": ["client/src/sw.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["vite-plugin-pwa/client"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
